<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_saved_vehicle_tree" model="ir.ui.view">
            <field name="name">saved.vehicle.tree</field>
            <field name="model">vehicle_repair_management.saved_vehicle</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="plate_no"/>
                    <field name="customer_id"/>
                    <field name="brand_id"/>
                    <field name="model"/>
                </tree>
            </field>
        </record>

        <record id="view_saved_vehicle_form" model="ir.ui.view">
            <field name="name">saved.vehicle.form</field>
            <field name="model">vehicle_repair_management.saved_vehicle</field>
            <field name="arch" type="xml">
                <form string="Vehicle Detail">
                    <sheet>
                        <div class="oe_title">
                            <label for="plate_no" class="oe_edit_only" string="Plate No"/>
                            <h1><field name="plate_no" placeholder="e.g. MH12RN1289"/></h1>
                        </div>
                        
                        <group>
                            <group string="Customer Detail">
                                <field name="customer_id"/>
                                <field name="phone"/>
                                <field name="email"/>
                            </group>
                            <group string="Vehicle Detail">
                                <field name="vehicle_type_id" options="{'no_open': True}"/>
                                <field name="brand_id"/>
                                <field name="model"/>
                                <field name="year"/>
                                <field name="color"/>
                                <field name="transmission"/>
                                <field name="fuel_type_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_saved_vehicle" model="ir.actions.act_window">
            <field name="name">Saved Vehicles</field>
            <field name="res_model">vehicle_repair_management.saved_vehicle</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
