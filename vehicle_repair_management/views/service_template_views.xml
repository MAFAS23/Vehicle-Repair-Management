<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_service_template_tree" model="ir.ui.view">
            <field name="name">service.template.tree</field>
            <field name="model">vehicle_repair_management.service_template</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="vehicle_type_id"/>
                    <field name="brand_id"/>
                    <field name="team_id"/>
                </tree>
            </field>
        </record>

        <record id="view_service_template_form" model="ir.ui.view">
            <field name="name">service.template.form</field>
            <field name="model">vehicle_repair_management.service_template</field>
            <field name="arch" type="xml">
                <form string="Service Template">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Title/Name"/>
                            <h1><field name="name" placeholder="e.g. BMW Service One"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="vehicle_type_id"/>
                                <field name="brand_id"/>
                                <field name="team_id"/>
                                <field name="member_ids" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="active" widget="boolean_toggle" string="Status Active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Service / Repair Work">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="mechanic_id"/>
                                        <field name="service_id"/>
                                        <field name="description"/>
                                        <field name="cost_type"/>
                                        <field name="cost"/>
                                        <field name="uom"/>
                                        <field name="quantity"/>
                                        <field name="work_time" widget="float_time"/>
                                        <field name="subtotal" sum="Total"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_service_template" model="ir.actions.act_window">
            <field name="name">Service Templates</field>
            <field name="res_model">vehicle_repair_management.service_template</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
