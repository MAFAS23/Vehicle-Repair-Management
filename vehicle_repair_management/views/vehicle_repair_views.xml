<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- explicit list view definition -->
        <record model="ir.ui.view" id="vehicle_repair_management.list">
            <field name="name">vehicle_repair_management list</field>
            <field name="model">vehicle_repair_management.vehicle_repair_management</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="saved_vehicle_id"/>
                    <field name="client_id"/>
                    <field name="receiving_date"/>
                    <field name="brand_id"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'under_process'" decoration-success="state == 'done'" decoration-danger="state == 'cancel'"/>
                </tree>
            </field>
        </record>

        <!-- explicit form view definition -->
        <record model="ir.ui.view" id="vehicle_repair_management.form">
            <field name="name">vehicle_repair_management form</field>
            <field name="model">vehicle_repair_management.vehicle_repair_management</field>
            <field name="arch" type="xml">
                <form string="Service Order">
                    <header>
                        <button name="action_confirm" string="Confirm Service" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="action_under_process" string="Under Process" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                        <button name="action_done" string="Finish Service" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'under_process')]}"/>
                        <button name="action_cancel" string="Cancel Service" type="object" attrs="{'invisible': [('state', 'in', ('under_process', 'done', 'cancel'))]}"/>
                        
                        <button name="%(action_report_client_receipt)d" string="Print Client Receipt" type="action" icon="fa-print"/>
                        <button name="%(action_report_team_receipt)d" string="Print Service Team Receipt" type="action" icon="fa-print"/>
                        
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,under_process,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                            <label for="saved_vehicle_id" class="oe_edit_only" string="Plate Number"/>
                            <h2><field name="saved_vehicle_id" placeholder="Select Saved Vehicle"/></h2>
                        </div>
                        
                        <group>
                            <group string="Customer">
                                <field name="client_id"/>
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="unknown_issue"/>
                            </group>
                            <group string="Basic Information">
                                <field name="receiving_date"/>
                                <field name="delivery_date"/>
                                <field name="vehicle_type_id"/>
                                <field name="brand_id"/>
                            </group>
                        </group>
                        <group>
                            <group string="Issue">
                                <field name="work_description"/>
                            </group>
                            <group string="Lainnya">
                                <field name="service_template_id"/>
                                <field name="service_team_id"/>
                                <field name="team_leader_id"/>
                                <field name="priority" widget="priority"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Worksheet">
                                <field name="worksheet_line_ids">
                                    <tree editable="bottom">
                                        <field name="mechanic_id"/>
                                        <field name="service_id"/>
                                        <field name="description"/>
                                        <field name="cost_type"/>
                                        <field name="cost"/>
                                        <field name="uom"/>
                                        <field name="quantity"/>
                                        <field name="work_time" widget="float_time"/>
                                        <field name="subtotal" sum="Total"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Part Used">
                                <field name="part_line_ids">
                                    <tree editable="bottom">
                                        <field name="product_id"/>
                                        <field name="description"/>
                                        <field name="quantity"/>
                                        <field name="unit_price"/>
                                        <field name="subtotal" sum="Total"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Vehicle Information">
                                <group>
                                    <group string="Data Kendaraan">
                                        <field name="model"/>
                                        <field name="color"/>
                                        <field name="transmission_type"/>
                                        <field name="year_of_manufacturing"/>
                                        <field name="warranty"/>
                                        <field name="insurance"/>
                                        <field name="pollution"/>
                                        <field name="accomplished_date"/>
                                        <field name="last_change_oil"/>
                                        <field name="odometer_reading"/>
                                    </group>
                                    <group string="Bahan Bakar">
                                        <field name="fuel_level" widget="progressbar"/>
                                        <field name="fuel_type_id"/>
                                    </group>
                                </group>
                                <separator string="Accessories Available In Vehicle"/>
                                <field name="accessory_ids">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="quantity"/>
                                        <field name="description"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Images">
                                <group>
                                    <field name="image" widget="image" class="oe_avatar"/>
                                </group>
                            </page>
                        </notebook>
                        
                        <group name="note_group" col="6" class="mt-2 mt-md-0">
                            <group colspan="4">
                                <field name="notes" nolabel="1" placeholder="Terms and conditions, or additional notes..."/>
                            </group>
                            <group class="oe_subtotal_footer oe_right" colspan="2" name="repair_totals">
                                <field name="worksheets_expenses"/>
                                <field name="used_part_expenses"/>
                                <field name="estimated_repair_untaxed_expenses" class="oe_subtotal_footer_separator"/>
                            </group>
                        </group>
                        
                        <group>
                            <field name="create_uid" readonly="1" string="Created By"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- explicit kanban view definition -->
        <record model="ir.ui.view" id="vehicle_repair_management.kanban">
            <field name="name">vehicle_repair_management kanban</field>
            <field name="model">vehicle_repair_management.vehicle_repair_management</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="client_id"/>
                    <field name="saved_vehicle_id"/>
                    <field name="state"/>
                    <field name="estimated_repair_untaxed_expenses"/>
                    <field name="priority"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <strong><field name="estimated_repair_untaxed_expenses" widget="monetary"/></strong>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <strong>Client: </strong><field name="client_id"/>
                                    </div>
                                    <div>
                                        <strong>Vehicle: </strong><field name="saved_vehicle_id"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="state" widget="label_selection" options="{'classes': {'draft': 'info', 'confirmed': 'primary', 'under_process': 'warning', 'done': 'success', 'cancel': 'danger'}}"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="vehicle_repair_management.action_window">
            <field name="name">Vehicle Service Work Order</field>
            <field name="res_model">vehicle_repair_management.vehicle_repair_management</field>
            <field name="view_mode">kanban,tree,form</field>
        </record>
    </data>
</odoo>
