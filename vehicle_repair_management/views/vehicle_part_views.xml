<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherited View for product.template (Vehicle Parts) -->
        <record id="view_product_template_form_inherit_vehicle_part" model="ir.ui.view">
            <field name="name">product.template.form.inherit.vehicle.part</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <!-- Tambahkan field is_vehicle_part di dalam div options -->
                <xpath expr="//div[@name='options']" position="inside">
                    <span class="d-inline-block">
                        <field name="is_vehicle_part"/>
                        <label for="is_vehicle_part"/>
                    </span>
                </xpath>
            </field>
        </record>

        <!-- Action for Vehicle Parts -->
        <record id="action_vehicle_part" model="ir.actions.act_window">
            <field name="name">Vehicle Parts</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain">[('is_vehicle_part', '=', True)]</field>
            <field name="context">{'default_is_vehicle_part': True}</field>
        </record>
    </data>
</odoo>
