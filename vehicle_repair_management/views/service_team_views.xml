<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_service_team_tree" model="ir.ui.view">
            <field name="name">service.team.tree</field>
            <field name="model">vehicle_repair_management.service_team</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="team_leader_id"/>
                </tree>
            </field>
        </record>

        <record id="view_service_team_form" model="ir.ui.view">
            <field name="name">service.team.form</field>
            <field name="model">vehicle_repair_management.service_team</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Team Name"/>
                            <h1><field name="name" placeholder="e.g. Alpha Team"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="team_leader_id"/>
                                <field name="service_ids" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="description" placeholder="All Experts"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Team Members">
                                <field name="member_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="department_id"/>
                                        <field name="job_id"/>
                                        <field name="expertise_service_ids" widget="many2many_tags"/>
                                        <field name="parent_id" string="Manager"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_service_team" model="ir.actions.act_window">
            <field name="name">Service Teams</field>
            <field name="res_model">vehicle_repair_management.service_team</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
