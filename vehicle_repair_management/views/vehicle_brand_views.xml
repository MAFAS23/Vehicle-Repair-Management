<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="view_vehicle_brand_tree">
            <field name="name">vehicle_brand_tree</field>
            <field name="model">vehicle_repair_management.vehicle_brand</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="vehicle_type_ids" widget="many2many_tags"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="view_vehicle_brand_form">
            <field name="name">vehicle_brand_form</field>
            <field name="model">vehicle_repair_management.vehicle_brand</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Brand Name"/>
                            <h1><field name="name" placeholder="e.g. Toyota"/></h1>
                        </div>
                        <group>
                            <field name="vehicle_type_ids" widget="many2many_tags" placeholder="Select Manufactured Vehicle Types"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_vehicle_brand">
            <field name="name">Vehicle Brands</field>
            <field name="res_model">vehicle_repair_management.vehicle_brand</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
