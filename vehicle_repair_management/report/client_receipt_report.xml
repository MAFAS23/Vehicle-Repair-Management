<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_report_client_receipt" model="ir.actions.report">
            <field name="name">Client Receipt</field>
            <field name="model">vehicle_repair_management.vehicle_repair_management</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">vehicle_repair_management.report_client_receipt</field>
            <field name="report_file">vehicle_repair_management.report_client_receipt</field>
            <field name="print_report_name">'Receipt - %s' % (object.name)</field>
            <field name="binding_model_id" ref="vehicle_repair_management.model_vehicle_repair_management_vehicle_repair_management"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_client_receipt">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page">
                            
                            <!-- 1 & 2 Header Title and Order Number -->
                            <div class="row align-items-center mb-4">
                                <div class="col-8">
                                    <h2 class="mt-0 mb-1">Vehicle Service Work Order</h2>
                                    <p class="text-muted mb-0">Order Date: <span t-field="doc.create_date" t-options='{"widget": "datetime"}'/></p>
                                </div>
                                <div class="col-4 text-right">
                                    <div style="background-color: #f8f9fa; border: 2px solid #dee2e6; padding: 10px; border-radius: 5px; display: inline-block;">
                                        <h4 class="m-0 text-center">No. Order:<br/><strong><span t-field="doc.name"/></strong></h4>
                                    </div>
                                </div>
                            </div>

                            <!-- 3. Client Information -->
                            <h4 style="border-bottom: 2px solid #dee2e6; padding-bottom: 5px; margin-bottom: 15px;">Client Information</h4>
                            <div class="row mb-4">
                                <div class="col-6">
                                    <table class="table table-sm table-borderless">
                                        <tr><td style="width: 30%;"><strong>Name</strong></td><td>: <span t-field="doc.client_id.name"/></td></tr>
                                        <tr><td><strong>Address</strong></td><td>: 
                                            <span t-if="doc.client_id.street"><span t-field="doc.client_id.street"/>, </span>
                                            <span t-if="doc.client_id.city"><span t-field="doc.client_id.city"/> </span>
                                            <span t-if="doc.client_id.country_id"><span t-field="doc.client_id.country_id.name"/></span>
                                        </td></tr>
                                    </table>
                                </div>
                                <div class="col-6">
                                    <table class="table table-sm table-borderless">
                                        <tr><td style="width: 30%;"><strong>Email</strong></td><td>: <span t-field="doc.email"/></td></tr>
                                        <tr><td><strong>Phone</strong></td><td>: <span t-field="doc.phone"/></td></tr>
                                    </table>
                                </div>
                            </div>

                            <!-- 4. Vehicle Description -->
                            <h4 style="border-bottom: 2px solid #dee2e6; padding-bottom: 5px; margin-bottom: 15px;">Vehicle Description</h4>
                            <div class="row mb-4">
                                <div class="col-6">
                                    <table class="table table-sm table-borderless">
                                        <tr><td style="width: 40%;"><strong>Vehicle Type</strong></td><td>: <span t-field="doc.vehicle_type_id.name"/></td></tr>
                                        <tr><td><strong>Brand / Make</strong></td><td>: <span t-field="doc.brand_id.name"/></td></tr>
                                        <tr><td><strong>Model</strong></td><td>: <span t-field="doc.model"/></td></tr>
                                        <tr><td><strong>Color</strong></td><td>: <span t-field="doc.color"/></td></tr>
                                        <tr><td><strong>Transmission Type</strong></td><td>: <span t-field="doc.transmission_type"/></td></tr>
                                        <tr><td><strong>Year of Mfg.</strong></td><td>: <span t-field="doc.year_of_manufacturing"/></td></tr>
                                    </table>
                                </div>
                                <div class="col-6">
                                    <table class="table table-sm table-borderless">
                                        <tr><td style="width: 40%;"><strong>Warranty</strong></td><td>: <span t-esc="'✅' if doc.warranty else '❌'"/></td></tr>
                                        <tr><td><strong>Insurance</strong></td><td>: <span t-esc="'✅' if doc.insurance else '❌'"/></td></tr>
                                        <tr><td><strong>Pollution</strong></td><td>: <span t-esc="'✅' if doc.pollution else '❌'"/></td></tr>
                                        <tr><td><strong>Odometer Reading</strong></td><td>: <span t-field="doc.odometer_reading"/></td></tr>
                                        <tr><td><strong>Fuel Level</strong></td><td>: <span t-field="doc.fuel_level"/>%</td></tr>
                                        <tr><td><strong>Fuel Type</strong></td><td>: <span t-field="doc.fuel_type_id.name"/></td></tr>
                                    </table>
                                </div>
                            </div>

                            <!-- 5. Accessories Available In Vehicle -->
                            <h4 style="border-bottom: 2px solid #dee2e6; padding-bottom: 5px; margin-bottom: 15px;">Accessories Available In Vehicle</h4>
                            <table class="table table-sm table-bordered mb-4">
                                <thead style="background-color: #f8f9fa;">
                                    <tr>
                                        <th>Name</th>
                                        <th>Quantity</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="doc.accessory_ids">
                                        <tr t-foreach="doc.accessory_ids" t-as="acc">
                                            <td><span t-field="acc.name"/></td>
                                            <td><span t-field="acc.quantity"/></td>
                                            <td><span t-field="acc.description"/></td>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td colspan="3" class="text-center text-muted" style="padding: 20px;">No accessories recorded</td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <!-- 6. Work Sheet -->
                            <h4 style="border-bottom: 2px solid #dee2e6; padding-bottom: 5px; margin-bottom: 15px;">Work Sheet</h4>
                            <table class="table table-sm table-bordered mb-4">
                                <thead style="background-color: #f8f9fa;">
                                    <tr>
                                        <th>Service</th>
                                        <th>Description</th>
                                        <th>Work Time</th>
                                        <th>Price</th>
                                        <th>Qty</th>
                                        <th>Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.worksheet_line_ids" t-as="ws">
                                        <td><span t-field="ws.service_id.name"/></td>
                                        <td><span t-field="ws.description"/></td>
                                        <td><span t-field="ws.work_time" t-options='{"widget": "float_time"}'/> Minutes</td>
                                        <td><span t-field="ws.cost" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/> <span t-field="ws.uom"/></td>
                                        <td><span t-field="ws.quantity"/></td>
                                        <td><span t-field="ws.subtotal" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- 7. Expense Summary -->
                            <div class="row mb-4 justify-content-end">
                                <div class="col-6">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td>Work Sheet Expense</td>
                                            <td class="text-right"><span t-field="doc.worksheets_expenses" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/></td>
                                        </tr>
                                        <tr>
                                            <td>Used Part Expense</td>
                                            <td class="text-right"><span t-field="doc.used_part_expenses" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/></td>
                                        </tr>
                                        <tr style="border-top: 2px solid #dee2e6;">
                                            <td><strong>Estimated Repair Untaxed Expense</strong></td>
                                            <td class="text-right"><strong><span t-field="doc.estimated_repair_untaxed_expenses" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/></strong></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-12 text-center">
                                    <p class="text-muted" style="font-style: italic;">⚠️ Total Final Amount may vary, this is a repair work order estimate.</p>
                                </div>
                            </div>

                            <!-- 8. Signatures -->
                            <div class="row mt-5 pt-5">
                                <div class="col-6 text-center">
                                    <hr style="width: 60%; border-top: 1px solid black; margin: auto;"/>
                                    <br/><strong>Client Signature</strong>
                                </div>
                                <div class="col-6 text-center">
                                    <hr style="width: 60%; border-top: 1px solid black; margin: auto;"/>
                                    <br/><strong>Authorized Signature</strong>
                                </div>
                            </div>
                            
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
